# LedgerIQ Environment Configuration

# Application
PROJECT_NAME=LedgerIQ
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

# Security
JWT_SECRET=super_secret_jwt_key_ledgeriq_buildathon_2026_dev_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Production PostgreSQL: postgresql://ledgeriq:password@localhost:5432/ledgeriq_db
# Local fallback: sqlite+aiosqlite:///./ledgeriq.db
DATABASE_URL=sqlite+aiosqlite:///./ledgeriq.db
DB_ECHO=false

# Redis (optional, in-memory queue fallback enabled)
REDIS_URL=redis://localhost:6379/0

# AI Configuration
AI_PROVIDER=fallback # options: gemini, groq, openrouter, ollama, fallback
AI_MODEL_NAME=gemini-2.0-flash
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Razorpay API Credentials (Optional for live/test sync, not required for Demo Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
